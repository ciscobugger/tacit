pragma Singleton
import QtQuick
import Quickshell
import qs.modules.common.functions

// Tacit's kit (2026-10-08, the owner's go; https://claude.ai/artifact/CKcjMwxz7yFW8kEbpx5gXY): one set of inks, one
// meaning for colour, one type scale and corners, for every Tacit app. All of it follows the wallpaper's palette
// (Appearance's matugen roles); the inks reach fixed APCA contrast on the panel ground whatever the palette.
// Actions are Slab (widgets/Slab.qml). The token block comes from tacit-kit's tokens.json (kit v0, 2026-10-24);
// what is written by hand here is behaviour: the window's see-through and quieter().
Singleton {
    id: root

    // >>> tacit-kit tokens: generated by tacit-kit/tools/generate.py from tokens/tokens.json, do not edit by hand

    // ---- colour roles (reference: the wallpaper's palette, the five APCA inks; text by brightness, never opacity)
    // names, titles, the line in focus
    readonly property color inkMain: Appearance.colors.colInkMain
    // facts: size, time, length, details
    readonly property color inkSec: ColorUtils.mix(Appearance.colors.colInkMain, Appearance.colors.colInkSecondary, 0.25)
    // a name beside a name, ordinals, rail counts
    readonly property color inkMeta: ColorUtils.mix(Appearance.colors.colInkSecondary, Appearance.colors.colInkMeta, 0.4)
    // unavailable
    readonly property color inkFaint: Appearance.colors.colInkFaint
    // the one line under a header, rail to page
    readonly property color hairline: Appearance.colors.colInkDivider
    // the current place, the primary action's ring, what is playing, a selection ring, the caret; never text
    readonly property color accent: Appearance.m3colors.m3primary
    // text on an accent fill. Was onAccent, which QML takes for a signal handler (on + capital): its binding never ran
    // and the text was black
    readonly property color inkOnAccent: Appearance.m3colors.m3onPrimary
    // a destructive action, always last, always with the warning symbol
    readonly property color risk: Appearance.m3colors.m3error
    // the ground slabs and panels stand on (the shell's)
    readonly property color ground: Appearance.m3colors.m3surfaceContainerLow
    // a slab raised from the shell's ground; not inside app windows
    readonly property color raised: ColorUtils.mix(root.inkMain, root.ground, 0.11)
    readonly property color raisedHot: ColorUtils.mix(root.inkMain, root.ground, 0.17)
    // an app window's ground, drawn at windowSeeThrough. The apps that parse the terminal's ground (sequences.txt OSC
    // 11) never match it (it is written with an alpha, ']11;[100]#...') and fall back to this; foot's own ground is one
    // step from it
    readonly property color windowGround: root.ground
    // a docked panel, a field in use; drawn at windowSeeThrough; never a group inside content
    readonly property color container: Appearance.m3colors.m3surfaceContainer
    // context lines: lyrics still to come, an unplayed waveform
    readonly property color quiet: root.quieter(root.inkMain, root.windowGround, 38)
    // lyrics already sung, the empty track of a line
    readonly property color past: root.quieter(root.inkMain, root.windowGround, 18)

    // ---- washes: inkMain over the ground at these amounts
    readonly property QtObject wash: QtObject {
        readonly property real hover: 0.05
        readonly property real current: 0.1
        readonly property real pressed: 0.22
        readonly property real action: 0.06
    }
    // ---- type sizes; hierarchy by size and weight
    readonly property QtObject size: QtObject {
        readonly property int display: 56
        readonly property int alarm: 40
        readonly property int headline: 30
        readonly property int section: 22
        readonly property int body: 17
        readonly property int row: 15
        readonly property int fileText: 14
        readonly property int meta: 13
    }
    // ---- the 4 px grid's steps
    readonly property QtObject space: QtObject {
        readonly property int xs: 4
        readonly property int s: 8
        readonly property int m: 12
        readonly property int l: 16
        readonly property int xl: 24
        readonly property int xxl: 32
        readonly property int page: 48
    }
    // ---- heights
    readonly property QtObject height: QtObject {
        readonly property int header: 72
        readonly property int row: 44
        readonly property int richRow: 72
        readonly property int railRow: 32
        readonly property int action: 40
        readonly property int field: 36
        readonly property int band: 84
    }
    // ---- widths
    readonly property QtObject width: QtObject {
        readonly property int rail: 300
        readonly property int railFolded: 56
        readonly property int panel: 400
        readonly property int list: 720
    }
    // ---- corners
    readonly property QtObject radius: QtObject {
        readonly property int art: 6
        readonly property int row: 8
        // deprecated: no users; rows are 8. Goes after one release.
        readonly property int rowSlab: 10
        readonly property int slab: 12
        readonly property int panel: 14
        readonly property int window: 18
    }
    // ---- symbol sizes
    readonly property QtObject icon: QtObject {
        readonly property int rail: 17
        readonly property int row: 20
        readonly property int nav: 22
    }
    // ---- motion: easing.bezierCurve and duration for each named scheme (curve [] = linear)
    readonly property QtObject motion: QtObject {
        readonly property QtObject arrive: QtObject { readonly property var curve: [0.05, 0.7, 0.1, 1.0, 1, 1]; readonly property int ms: 300 }
        readonly property QtObject arriveSmall: QtObject { readonly property var curve: [0.05, 0.7, 0.1, 1.0, 1, 1]; readonly property int ms: 250 }
        readonly property QtObject leave: QtObject { readonly property var curve: [0.3, 0.0, 0.8, 0.15, 1, 1]; readonly property int ms: 200 }
        readonly property QtObject fade: QtObject { readonly property var curve: [0.34, 0.8, 0.34, 1.0, 1, 1]; readonly property int ms: 200 }
        readonly property QtObject fadeFast: QtObject { readonly property var curve: [0.31, 0.94, 0.34, 1.0, 1, 1]; readonly property int ms: 150 }
        readonly property QtObject hover: QtObject { readonly property var curve: []; readonly property int ms: 80 }
        readonly property QtObject spring: QtObject { readonly property var curve: [0.42, 1.67, 0.21, 0.9, 1, 1]; readonly property int ms: 350 }
    }
    // ---- states
    readonly property QtObject state: QtObject {
        readonly property real pressScale: 0.97
        readonly property real focusRing: 2
        readonly property real focusGap: 2
    }
    // <<< tacit-kit tokens

    // how far every Tacit app's window lets the blur through, as Settings > Appearance has it: Frosted is the terminal's
    // ground at foot's alpha 0.85 (foot.ini), Solid none, Clear its own amount. One number, so the apps cannot drift
    // apart (Praxis and the Store had, 2026-10-15). Shell surfaces use the frost. On a bright wallpaper less, by
    // Appearance.seeThroughScale, so the ground stays as dark as on dusk.
    readonly property real windowSeeThrough: (!Config.options.appearance.transparency.enable ? 0
        : Config.options.appearance.transparency.automatic ? 0.15 : Config.options.appearance.transparency.backgroundTransparency)
        * Appearance.seeThroughScale

    // `fg` toward `bg` as far as it keeps APCA Lc `lc` on `bg`: a quieter line in the same ink
    function quieter(fg, bg, lc) {
        let lo = 0, hi = 1;
        for (let i = 0; i < 16; i++) {
            const mid = (lo + hi) / 2;
            if (Math.abs(ColorUtils.apcaLc(ColorUtils.mix(fg, bg, mid), bg)) >= lc)
                hi = mid;
            else
                lo = mid;
        }
        return ColorUtils.mix(fg, bg, hi);
    }
}
