# Tacit's look for apps that ask GSettings (GTK 4, libadwaita, the portals), for everyone; what a person sets wins.
# The owner's values (2026-10-16).
[org.gnome.desktop.interface]
icon-theme='Quiet'
cursor-theme='Tacit'
cursor-size=24
font-name='Tacit Sans 11'
document-font-name='Tacit Sans 11'
monospace-font-name='Tacit Mono 11'
gtk-theme='adw-gtk3-dark'
color-scheme='prefer-dark'
font-antialiasing='grayscale'
font-hinting='slight'
font-rgba-order='rgb'
