#!/bin/bash
# tacit-fetch-updates: keep this computer's list of packages fresh and download the waiting updates, never install them
# (macOS's "Download new updates when available"). Getting an app in Apps then finds the updates it comes with already here.
# Runs as the system from tacit-fetch-updates.timer. Skips quietly while pacman is busy, on battery under 40 %, or offline.
# (From ~/dev/tacit-updates 5b2428e; tacit-session installs it.)
set -u

# pacman at work: not now. A lock with no pacman behind it is one a stopped pacman left (a restart in the middle of a
# download), and kept every later download from starting
if [ -e /var/lib/pacman/db.lck ]; then
    pgrep -x pacman >/dev/null && exit 0
    rm -f /var/lib/pacman/db.lck
fi

on_mains=0 battery=""
for d in /sys/class/power_supply/*; do
    # a wireless mouse's battery is not the computer's
    [ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
    case "$(cat "$d/type" 2>/dev/null)" in
        Mains|USB|USB_C|USB_PD*) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && on_mains=1 ;;
        Battery) c=$(cat "$d/capacity" 2>/dev/null) && [ -n "$c" ] && { [ -z "$battery" ] || [ "$c" -lt "$battery" ]; } && battery=$c ;;
    esac
done
# asked for in Settings (tacit-fetch-updates-now.service): the person wants it, whatever the battery says
if [ "${1:-}" != now ] && [ "$on_mains" = 0 ] && [ -n "$battery" ] && [ "$battery" -lt 40 ]; then
    echo "on battery at ${battery} %: not now"
    exit 0
fi

# -Syuw: refresh the list and download what the next update needs; nothing is installed or removed
pacman -Syuw --noconfirm --noprogressbar || exit
# older downloads of a package a newer one replaced are never installed; pacman -Sc would also take the waiting ones
paccache -rk1 -q 2>/dev/null || true
# when the last look worked, whether or not anything had changed: pacman leaves a list it finds current untouched, and
# Settings' "Checked at" (the lists' time) went back to when something last came
install -d /var/lib/tacit && touch /var/lib/tacit/updates-checked
